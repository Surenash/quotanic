                    <div style={{ display: 'flex', alignItems: 'center', gap: '16px' }}><WrenchScrewdriverIcon style={{ ...styles.forWhomIcon, color: '#F005B4' }} /><h3 style={styles.featureTitle}>For Manufacturers</h3></div>
