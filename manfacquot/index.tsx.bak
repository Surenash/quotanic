        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
        gap: '16px',
        marginBottom: '32px'
    },
    intelCard: {
        padding: '20px',
        background: 'linear-gradient(135deg, rgba(10,240,240,0.1) 0%, rgba(240,5,180,0.05) 100%)',
        border: '1px solid rgba(175, 200, 255, 0.15)',
        borderRadius: '12px',
        textAlign: 'center'
    },
    toolCard: {
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center',
        padding: '16px',
        marginBottom: '12px',
        backgroundColor: 'rgba(30, 30, 40, 0.5)',
        borderRadius: '8px',
        border: '1px solid rgba(175, 200, 255, 0.15)'
    },
    toolCost: {
        display: 'flex',
        flexDirection: 'column',
        gap: '4px',
        alignItems: 'flex-end',
        fontSize: '12px',
        color: text_secondary
    },
    optimizationCard: {
        padding: '16px',
        marginBottom: '16px',
        backgroundColor: 'rgba(16, 185, 129, 0.1)',
        border: '1px solid #10B981',
        borderRadius: '8px'
    },
    savingsBadge: {
        backgroundColor: '#10B981',
        color: '#fff',
        padding: '4px 8px',
        borderRadius: '4px',
        fontSize: '12px',
        fontWeight: 600,
        marginLeft: '8px'
    },
    alertBox: {
        padding: '12px',
        backgroundColor: 'rgba(245, 158, 11, 0.1)',
        border: '1px solid #F59E0B',
        borderRadius: '8px',
        marginTop: '12px',
        color: '#F59E0B'
    },
    section: {
        marginBottom: '32px'
    },
    dimCard: {
        display: 'flex',
        gap: '16px',
        padding: '8px 12px',
        backgroundColor: 'rgba(0,0,0,0.2)',
        borderRadius: '6px',
        marginBottom: '8px',
        fontSize: '13px'
    },
    opportunityCard: {
        padding: '16px',
        marginBottom: '12px',
        backgroundColor: 'rgba(59, 130, 246, 0.1)',
        border: '1px solid #3B82F6',
        borderRadius: '8px'
    },
    oppStats: {
        display: 'flex',
        gap: '16px',
        marginTop: '12px',
        fontSize: '13px',
        color: text_secondary
    },
    featureBadge: {
        display: 'inline-block',
        padding: '6px 12px',
        backgroundColor: 'rgba(10, 240, 240, 0.1)',
        border: '1px solid rgba(10, 240, 240, 0.3)',
        borderRadius: '6px',
        fontSize: '13px',
        color: neon_cyan,
        marginRight: '8px',
        marginBottom: '8px'
    },
    warningBox: {
        padding: '16px',
        backgroundColor: 'rgba(239, 68, 68, 0.1)',
        border: '1px solid #EF4444',
        borderRadius: '8px',
        marginTop: '24px',
        color: '#EF4444'
    },
    analysisSummary: {
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(150px, 1fr))',
        gap: '16px',
        margin: '24px 0'
    },
    featureGrid: {
        display: 'flex',
        flexWrap: 'wrap',
        gap: '8px',
        marginTop: '16px',
        marginBottom: '24px'
    },
    chip: {
        border: `1px solid ${border_color}`,
        backgroundColor: 'rgba(16, 24, 48, 0.4)',
        padding: '8px 14px',
        borderRadius: '16px',
        cursor: 'pointer',
        fontSize: '13px',
        color: text_secondary,
        transition: 'all 0.2s'
    },
    chipActive: {
        backgroundColor: 'rgba(10, 240, 240, 0.2)',
        border: `1px solid ${neon_cyan}`,
        color: neon_cyan
    },
    quoteSubmission: {
        marginTop: '32px',
        padding: '24px',
        backgroundColor: 'rgba(16, 24, 48, 0.6)',
        border: `1px solid ${border_color}`,
        borderRadius: '12px'
    }
};

ReactDOM.createRoot(document.getElementById('root')!).render(
    <React.StrictMode>
        <App />
    </React.StrictMode>
);